# PROFESSOR-XMD — nakili kama .env.local na ujaze. Hakuna key ndani ya code.

# ── Appwrite (sessions, reports, ledger, search cache) ──
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
# collection ya reports (default: reports) · sessions = boardroom_sessions · ledger = board_ledger
REPORTS_COLLECTION_ID=reports
# Agent chat: collection agent_conversations (ID 6ab6d7990026978d4ba9) IMEWEKWA NDANI YA CODE — hakuna env inayohitajika.
# (hiari) kubadilisha ID tu: AGENT_CHATS_COLLECTION_ID=<id nyingine>
# collection ya search cache (semantic cache ya SearXNG)
APPWRITE_COLLECTION_ID=

# ── XKiro (stage 0/1) — OpenAI-compatible; usage inasomwa live (stream_options.include_usage) ──
XTROUTER_BASE_URL=https://api.xkiro.com/v1
XTROUTER_MODEL=qwen/qwen3.8-max:free
XTROUTER_API_KEY=
# key kwa kila agent (hiari): XTROUTER_API_KEY_<PERSONA>_1 / _2
XTROUTER_API_KEY_OPTIMUS_1=
XTROUTER_API_KEY_OPTIMUS_2=
XTROUTER_API_KEY_ULTRON_1=
XTROUTER_API_KEY_ULTRON_2=
XTROUTER_API_KEY_VEXTRON_1=
XTROUTER_API_KEY_VEXTRON_2=
XTROUTER_API_KEY_MEGATRON_1=
XTROUTER_API_KEY_MEGATRON_2=
XTROUTER_API_KEY_CYBERTRON_1=
XTROUTER_API_KEY_CYBERTRON_2=

# ── Groq (stage 2/3) ──
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
# GROQ_API_KEY_<PERSONA>_1 / _2 (hiari) — models: qwen/qwen3.8-27b → openai/gpt-oss-120b (compound iliondolewa na Groq)
# Keys zote za _1 = akaunti/organization moja ("Key 1"), za _2 = nyingine ("Key 2"). Pulse inaonyesha circle 5:
# XKiro 1 · XKiro 2 · Groq 1 · Groq 2 · TokenHarbor — namba halisi (XKiro /v1/usage, headers za Groq/TokenHarbor,
# limits za Groq kutoka docs zao live). Daftari linahifadhiwa .xmd/usage-ledger.json (usiliweke git).

# ── TokenHarbor (stage 4 — relief) ──
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKENHARBOR_MODEL=deepseek-v4.1-flash:free
TOKENHARBOR_API_KEY=

# ── Search ──
SEARXNG_URL=
# embeddings za search cache
# R18: Gemini (chat lanes + embeddings za search cache) — HuggingFace imeondolewa
GEMINI_API_KEY_1=
# R19: project ya PILI ya Google (quota ni ya project, si key — key ya project ileile haiongezi kitu)
GEMINI_API_KEY_2=

# ── Muda wa app (tarehe ya "leo", sessions/usage za siku) ──
APP_TIMEZONE=Africa/Dar_es_Salaam

# ── Ledger (hiari) ──
# LEDGER_DECISION_SUMMARY_MAX=4000
# LEDGER_APPROVED_CODE_MAX=65000

# ===== AGENT BRAIN (R11) =====
# Memory ya agents: on (default) | off — off inazima recall, checkpoints, reflection, consolidation,
# chat memory na muhtasari wa rolling kwa LLM (kuokoa tokens). Chat bado inabeba mazungumzo ya zamani kwa kubana.
BRAIN_MEMORY=on
# Kikomo cha herufi za skill modules kwa wito mmoja — default 0 = BILA kikomo (modules zote zinazohusika zinapakiwa kamili). Modules za SKILL_REQUEST hazikatwi kamwe.
BRAIN_SKILL_BUDGET=0

# ===== MJADALA (R12) — hiari; bila kuweka, defaults ndizo hizi =====
# Kikomo cha zamu za owners kwa agenda moja. Kikifikiwa (au zamu 3 mfululizo bila jipya), mwenyekiti
# anafunga kwa uamuzi bora uliopo au DEFER, kisha kura moja ya mwisho. Hakuna infinite loop.
BRAIN_MAX_OWNER_TURNS=12
# Idadi ya RESEARCH_REQUEST kwa kila owner kwa agenda moja (queries zinazofanana zinarukwa zenyewe).
BRAIN_RESEARCH_PER_ITEM=6
