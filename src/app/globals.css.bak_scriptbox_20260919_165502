/* ===== BOARDROOM HERO LAYOUT FIX ===== */
html, body {
  overflow-x: hidden;
}
.boardroom-hero {
  position: relative;
  isolation: isolate;
  width: min(92vw, 820px);
  max-width: 100%;
  margin: 6vh auto 0;
  box-sizing: border-box;
  touch-action: pan-y;
}

/* Ambient glow ya nyuma — inatoa mwanga wa rangi kabla ya picha */
.boardroom-hero::before {
  content: "";
  position: absolute;
  inset: -18% -14%;
  z-index: -1;
  border-radius: 9999px;
  background:
    radial-gradient(55% 52% at 50% 46%, color-mix(in oklab, var(--primary) 24%, transparent), transparent 72%),
    radial-gradient(40% 36% at 26% 64%, color-mix(in oklab, var(--accent) 15%, transparent), transparent 74%),
    radial-gradient(40% 36% at 74% 64%, color-mix(in oklab, var(--primary) 13%, transparent), transparent 74%);
  filter: blur(42px);
  opacity: 0.8;
  pointer-events: none;
  animation: hero-glow-pulse 7s ease-in-out infinite;
}

/* Vignette ya kina — hii ndio inayofanya picha "ipotee" ndani ya background,
   sawa na jinsi maneno yanavyofifia kwenye screenshot uliyotuma */
.boardroom-hero::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  border-radius: 32px;
  background:
    repeating-linear-gradient(0deg, oklch(1 0 0 / 2.5%) 0 1px, transparent 1px 3px),
    radial-gradient(120% 110% at 50% 45%, transparent 30%, color-mix(in oklab, var(--background) 55%, transparent) 62%, var(--background) 100%),
    linear-gradient(to right, var(--background) 0%, transparent 14%, transparent 86%, var(--background) 100%),
    linear-gradient(to bottom, var(--background) 0%, transparent 16%, transparent 84%, var(--background) 100%);
}

.boardroom-hero-img {
  display: block;
  width: 100%;
  max-width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  object-position: 50% 42%;
  border-radius: 32px;
  filter: brightness(0.94) saturate(1.05);
  -webkit-mask-image: radial-gradient(115% 105% at 50% 45%, #000 34%, rgba(0,0,0,0.55) 58%, transparent 92%);
  mask-image: radial-gradient(115% 105% at 50% 45%, #000 34%, rgba(0,0,0,0.55) 58%, transparent 92%);
  touch-action: pan-y;
  user-select: none;
  -webkit-user-drag: none;
  -webkit-user-select: none;
  pointer-events: none;
}

@keyframes hero-glow-pulse {
  0%, 100% { opacity: 0.6; transform: scale(1); }
  50% { opacity: 0.95; transform: scale(1.06); }
}
/* ===== BOARDROOM HERO LAYOUT FIX END ===== */

/* ===== VIEWPORT KEYBOARD FIX ===== */
:root {
  --app-height: 100dvh;
  --kb-height: 0px; /* itasasishwa na JS pale keyboard inapofunguka */
}

/* Tumia hii class kwenye root shell wrapper yako badala ya h-screen/100vh */
.app-shell {
  height: var(--app-height);
  height: 100dvh; /* fallback */
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Header — haipungui kamwe */
.app-header {
  flex-shrink: 0;
}

/* Content ya kati — hii pekee ndio inayo-scroll na kupungua */
.app-content {
  flex: 1 1 auto;
  min-height: 0; /* MUHIMU: bila hii flex child haiwezi ku-scroll sahihi */
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* Input bar / footer — haipungui, inabaki juu ya keyboard */
.app-footer {
  flex-shrink: 0;
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
/* ===== VIEWPORT KEYBOARD FIX END ===== */
