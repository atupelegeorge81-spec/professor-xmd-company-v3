@import "tailwindcss" source(none);
@source "../";

/*
 * PROFESSOR-XMD-COMPANY design system.
 * Dark-first "command deck": deep space navy surfaces, cyan/violet signal
 * accents, glass panels, crisp high-DPI avatars.
 */

@theme inline {
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
  --radius-2xl: calc(var(--radius) + 8px);
  --radius-3xl: calc(var(--radius) + 12px);

  --font-display: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  --font-sans: "DM Sans", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, monospace;

  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-surface: var(--surface);
  --color-surface-2: var(--surface-2);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-success: var(--success);
  --color-warning: var(--warning);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-border-strong: var(--border-strong);
  --color-input: var(--input);
  --color-ring: var(--ring);
}

:root {
  --radius: 0.9rem;

  --background: oklch(0.16 0.024 265);
  --foreground: oklch(0.97 0.005 250);
  --surface: oklch(0.2 0.028 266);
  --surface-2: oklch(0.245 0.032 267);
  --card: oklch(0.21 0.03 266);
  --card-foreground: oklch(0.97 0.005 250);
  --popover: oklch(0.185 0.026 265);
  --popover-foreground: oklch(0.97 0.005 250);

  --primary: oklch(0.79 0.14 220);
  --primary-foreground: oklch(0.18 0.03 265);
  --secondary: oklch(0.28 0.035 268);
  --secondary-foreground: oklch(0.95 0.01 250);
  --muted: oklch(0.26 0.03 267);
  --muted-foreground: oklch(0.7 0.024 262);
  --accent: oklch(0.7 0.19 305);
  --accent-foreground: oklch(0.98 0.005 250);

  --success: oklch(0.76 0.16 155);
  --warning: oklch(0.82 0.15 80);
  --destructive: oklch(0.65 0.21 25);
  --destructive-foreground: oklch(0.98 0.005 250);

  --border: oklch(1 0 0 / 9%);
  --border-strong: oklch(1 0 0 / 18%);
  --input: oklch(1 0 0 / 12%);
  --ring: oklch(0.79 0.14 220 / 55%);

  --gradient-signal: linear-gradient(135deg, var(--primary), var(--accent));
  --gradient-veil: radial-gradient(
      1100px 620px at 12% -12%,
      color-mix(in oklab, var(--primary) 20%, transparent),
      transparent 62%
    ),
    radial-gradient(900px 560px at 92% 4%, color-mix(in oklab, var(--accent) 17%, transparent), transparent 60%);
  --shadow-panel: 0 24px 70px -28px oklch(0 0 0 / 85%);
  --shadow-glow: 0 0 0 1px color-mix(in oklab, var(--primary) 26%, transparent),
    0 12px 40px -14px color-mix(in oklab, var(--primary) 42%, transparent);
}

@layer base {
  * {
    border-color: var(--color-border);
  }

  html,
  body {
    height: 100%;
  }

  body {
    background-color: var(--color-background);
    background-image: var(--gradient-veil);
    background-attachment: fixed;
    color: var(--color-foreground);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3,
  .font-display {
    font-family: var(--font-display);
    letter-spacing: -0.018em;
  }

  ::selection {
    background: color-mix(in oklab, var(--primary) 35%, transparent);
  }
}

/* ---------- Surfaces ---------- */

@utility glass {
  background: color-mix(in oklab, var(--surface) 62%, transparent);
  border: 1px solid var(--border);
  backdrop-filter: blur(18px) saturate(150%);
  -webkit-backdrop-filter: blur(18px) saturate(150%);
}

@utility glass-strong {
  background: color-mix(in oklab, var(--surface) 88%, transparent);
  border: 1px solid var(--border-strong);
  backdrop-filter: blur(28px) saturate(165%);
  -webkit-backdrop-filter: blur(28px) saturate(165%);
  box-shadow: var(--shadow-panel);
}

@utility panel-hover {
  transition:
    transform 0.24s cubic-bezier(0.22, 1, 0.36, 1),
    border-color 0.24s ease,
    background-color 0.24s ease;
  &:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--primary) 42%, transparent);
    background-color: color-mix(in oklab, var(--surface-2) 78%, transparent);
  }
}

@utility text-signal {
  background: var(--gradient-signal);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

@utility bg-signal {
  background-image: var(--gradient-signal);
}

@utility ring-signal {
  box-shadow: var(--shadow-glow);
}

/* ---------- Crisp high-DPI avatars ---------- */

@utility avatar-frame {
  position: relative;
  display: grid;
  place-items: center;
  flex: none;
  border-radius: 9999px;
  overflow: hidden;
  isolation: isolate;
  background: color-mix(in oklab, var(--surface-2) 90%, transparent);
  box-shadow:
    inset 0 0 0 1px oklch(1 0 0 / 16%),
    0 6px 18px -10px oklch(0 0 0 / 90%);
}

@utility avatar-img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center top;
  border-radius: inherit;
  /* keep raster avatars sharp on retina/scaled containers */
  image-rendering: -webkit-optimize-contrast;
  transform: translateZ(0);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  will-change: transform;
}

@utility avatar-live {
  &::after {
    content: "";
    position: absolute;
    inset: -2px;
    border-radius: 9999px;
    padding: 2px;
    background: conic-gradient(
      from 0deg,
      color-mix(in oklab, var(--primary) 90%, transparent),
      color-mix(in oklab, var(--accent) 90%, transparent),
      color-mix(in oklab, var(--primary) 90%, transparent)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: spin-ring 2.6s linear infinite;
    pointer-events: none;
  }
}

/* ---------- Motion ---------- */

@keyframes spin-ring {
  to {
    transform: rotate(360deg);
  }
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.985);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes chip-pop {
  0% {
    opacity: 0;
    transform: translateY(6px) scale(0.9);
  }
  60% {
    transform: translateY(0) scale(1.03);
  }
  100% {
    opacity: 1;
    transform: none;
  }
}

@keyframes sheet-up {
  from {
    opacity: 0;
    transform: translateY(26px) scale(0.985);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes slide-in-right {
  from {
    opacity: 0;
    transform: translateX(26px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes sweep {
  0% {
    background-position: -180% 0;
  }
  100% {
    background-position: 180% 0;
  }
}

@keyframes pulse-soft {
  0%,
  100% {
    opacity: 0.45;
  }
  50% {
    opacity: 1;
  }
}

@utility rise-in {
  animation: rise-in 0.34s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@utility chip-in {
  animation: chip-pop 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@utility sheet-up {
  animation: sheet-up 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@utility menu-right {
  animation: slide-in-right 0.26s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@utility thinking-sweep {
  background: linear-gradient(
    90deg,
    color-mix(in oklab, var(--muted-foreground) 70%, transparent) 20%,
    var(--think-color, oklch(0.85 0.13 220)) 50%,
    color-mix(in oklab, var(--muted-foreground) 70%, transparent) 80%
  );
  background-size: 220% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: sweep 1.6s linear infinite;
}

@utility caret {
  display: inline-block;
  width: 2px;
  height: 0.95em;
  vertical-align: -0.08em;
  margin-left: 2px;
  border-radius: 2px;
  background: var(--primary);
  animation: pulse-soft 1s ease-in-out infinite;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ---------- Scrollbars ---------- */

@utility scroll-thin {
  scrollbar-width: thin;
  scrollbar-color: color-mix(in oklab, var(--primary) 30%, transparent) transparent;
  &::-webkit-scrollbar {
    width: 7px;
    height: 7px;
  }
  &::-webkit-scrollbar-thumb {
    border-radius: 9999px;
    background: color-mix(in oklab, var(--primary) 26%, transparent);
  }
  &::-webkit-scrollbar-thumb:hover {
    background: color-mix(in oklab, var(--primary) 45%, transparent);
  }
  &::-webkit-scrollbar-track {
    background: transparent;
  }
}

/* ---------- Print (report export) ---------- */

#print-sheet {
  display: none;
}

@media print {
  body * {
    visibility: hidden !important;
  }
  #print-sheet,
  #print-sheet * {
    visibility: visible !important;
  }
  #print-sheet {
    display: block !important;
    position: absolute;
    inset: 0;
    padding: 24px;
    background: #fff;
    color: #000;
  }
}


/* ===== PROFESSOR-XMD legacy animations intentionally preserved ===== */
.xmd-avatar-glow { position: relative; animation: none !important; }
.xmd-avatar-glow::before {
  content: "";
  position: absolute;
  inset: -3px;
  border-radius: 9999px;
  background: conic-gradient(
    from 0deg,
    var(--agent-glow,#38BDF8) 0deg,
    var(--agent-glow2,var(--agent-glow,#38BDF8)) 180deg,
    var(--agent-glow,#38BDF8) 360deg
  );
  -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
  mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
  filter: saturate(1.8) drop-shadow(0 0 6px var(--agent-glow,#38BDF8));
  pointer-events: none;
}
.xmd-avatar-glow::after {
  content: "";
  position: absolute;
  inset: -5px;
  border-radius: 9999px;
  background: conic-gradient(
    from 0deg,
    transparent 0deg,
    transparent 240deg,
    var(--agent-glow,#38BDF8) 300deg,
    #ffffff 330deg,
    var(--agent-glow,#38BDF8) 350deg,
    transparent 360deg
  );
  -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 6px), #000 calc(100% - 4px));
  mask: radial-gradient(farthest-side, transparent calc(100% - 6px), #000 calc(100% - 4px));
  animation: xmd-orbit-spin 1.6s linear infinite;
  filter: drop-shadow(0 0 8px var(--agent-glow,#38BDF8));
  pointer-events: none;
}
@keyframes xmd-orbit-spin { to { transform: rotate(360deg); } }
.xmd-thinking-sweep {
  position: relative;
  display: inline-block;
  color: rgba(255,255,255,0.42);
  --think-color: #8ab4f8;
}
.xmd-thinking-sweep::after {
  content: attr(data-text);
  position: absolute;
  left: 0;
  top: 0;
  color: var(--think-color);
  text-shadow: 0 0 8px var(--think-color), 0 0 16px var(--think-color);
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 50%, transparent 100%);
  mask-image: linear-gradient(90deg, transparent 0%, #000 50%, transparent 100%);
  -webkit-mask-size: 220% 100%;
  mask-size: 220% 100%;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  animation: xmd-think-sweep 1.8s linear infinite;
  pointer-events: none;
}
@keyframes xmd-think-sweep {
  0% { -webkit-mask-position: 100% 0; mask-position: 100% 0; }
  100% { -webkit-mask-position: 0% 0; mask-position: 0% 0; }
}

/* Existing keyboard behavior is retained without changing the new layout shell. */
.xmd-keyboard-composer { position: relative; z-index: 50; }
.xmd-message-composer-input { transform: none !important; font-size: 16px !important; }

