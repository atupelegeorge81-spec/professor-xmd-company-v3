"use client";
import React, { useEffect, useRef, useState } from "react";
import ReactMarkdown from "react-markdown";
import remarkGfm from "remark-gfm";
import remarkMath from "remark-math";
import rehypeKatex from "rehype-katex";
import { ShikiCodeLines } from "./ShikiCodeLines";
import type { ScriptDiff } from "@/lib/types";

const ScriptDiffContext = React.createContext<ScriptDiff | undefined>(undefined);

function sanitizeMermaid(code: string): string {
  let c = code
    .replace(/[\u2010-\u2015\u2212]/g, "-")
    .replace(/[\u2018\u2019]/g, "'")
    .replace(/[\u201C\u201D]/g, '"')
    .replace(/\u00a0/g, " ")
    .replace(/[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}\u{FE0F}]/gu, "");
  c = c.replace(/\[([^\]"]*)\]/g, (m, inner) => (/[()"']/.test(inner) ? `["${inner.replace(/"/g, "'")}"]` : m));
  return c;
}

function MermaidBlock({ code }: { code: string }) {
  const ref = useRef<HTMLDivElement>(null);
  useEffect(() => {
    let cancelled = false;
    (async () => {
      const clean = sanitizeMermaid(code);
      try {
        const mermaid = (await import("mermaid")).default;
        mermaid.initialize({ startOnLoad: false, theme: "dark", securityLevel: "loose", suppressErrorRendering: true } as any);
        await mermaid.parse(clean);
        const { svg } = await mermaid.render("mmd" + Math.random().toString(36).slice(2, 8), clean);
        if (!cancelled && ref.current) ref.current.innerHTML = svg;
      } catch {
        if (!cancelled && ref.current) {
          ref.current.innerHTML = "";
          const pre = document.createElement("pre");
          pre.className = "overflow-x-auto text-[12px] leading-5 text-emerald-200";
          pre.textContent = code;
          ref.current.appendChild(pre);
        }
      }
    })();
    return () => { cancelled = true; };
  }, [code]);
  return <div ref={ref} className="my-2 overflow-x-auto rounded-xl border border-white/10 bg-black/40 p-3" />;
}

function ColorToken({ hex }: { hex: string }) {
  const [copied, setCopied] = useState(false);
  return (
    <button
      onClick={() => { navigator.clipboard?.writeText(hex); setCopied(true); setTimeout(() => setCopied(false), 1200); }}
      className="mx-0.5 inline-flex items-center gap-1 rounded-md border border-white/10 bg-black/20 px-1.5 py-0.5 align-middle font-mono text-[0.82em] text-zinc-200 hover:bg-white/10"
      title="Nakili HEX"
    >
      <span className="h-3 w-3 rounded-sm border border-white/20" style={{ background: hex }} />
      {copied ? "✓" : hex}
    </button>
  );
}

function ScriptBox({ title, lang, stats, fullCode }: {
  title: string;
  lang: string;
  stats: string;
  fullCode: string;
}) {
  const [copied, setCopied] = useState(false);
  const scriptDiff = React.useContext(ScriptDiffContext);
  const [showDiff, setShowDiff] = useState(Boolean(scriptDiff));

  const copy = async () => {
    try {
      await navigator.clipboard.writeText(fullCode);
      setCopied(true);
      setTimeout(() => setCopied(false), 1600);
    } catch {}
  };

  useEffect(() => {
    setShowDiff(Boolean(scriptDiff));
    if (!scriptDiff) return;
    const timer = setTimeout(() => setShowDiff(false), 2400);
    return () => clearTimeout(timer);
  }, [scriptDiff]);

  const transientDiff = showDiff && scriptDiff;

  return (
    <article className="sb sb-prism" data-lines="on">
      <header className="sb-head">
        <h3 className="sb-title">{title}</h3>
        <span className="sb-chip">{lang.toUpperCase()}</span>
        {stats ? <span className="sb-stats">{stats}</span> : null}
        <button type="button" className="sb-icon-btn" onClick={copy} aria-label="Copy code">
          {copied ? (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M20 6 9 17l-5-5"/></svg>
          ) : (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M4 16V6a2 2 0 0 1 2-2h10"/></svg>
          )}
          <span>{copied ? "Copied" : "Copy"}</span>
        </button>
      </header>

      <pre className="sb-body">
        {transientDiff ? (
          <div className="mb-3 overflow-hidden rounded-xl border border-white/10 bg-black/20 transition-opacity duration-500">
            <div className="border-b border-white/10 px-3 py-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-zinc-400">
              Surgical patch
            </div>
            <code className="sb-diff">
              {transientDiff.changes.flatMap((change, changeIndex) => {
                const oldRows = change.oldLines.map((line, i) => ({
                  kind: "del" as const,
                  line: change.startLine + i,
                  text: line || " ",
                }));
                const newStart = change.startLine;
                const newRows = change.newLines.map((line, i) => ({
                  kind: "add" as const,
                  line: newStart + i,
                  text: line || " ",
                }));
                const rows = [...oldRows, ...newRows];
                return rows.map((row, rowIndex) => {
                  const cls = row.kind === "del"
                    ? "sb-line sb-line-del"
                    : "sb-line sb-line-add";
                  return (
                    <div key={`${changeIndex}-${row.kind}-${rowIndex}`} className={cls}>
                      <span className="sb-ln">{row.line}</span>
                      <span className="sb-code">{row.text}</span>
                    </div>
                  );
                });
              })}
            </code>
          </div>
        ) : null}

        <div className={transientDiff ? "opacity-95 transition-opacity duration-500" : "opacity-100"}>
          <ShikiCodeLines code={fullCode} language={lang} />
        </div>
      </pre>
    </article>
  );
}

function extractCodeText(node: React.ReactNode): string {
  if (node == null) return "";
  if (typeof node === "string" || typeof node === "number") {
    return String(node);
  }

  if (Array.isArray(node)) {
    return node.map(extractCodeText).join("");
  }

  if (React.isValidElement(node)) {
    return extractCodeText(
      (node.props as { children?: React.ReactNode }).children,
    );
  }

  return "";
}

function CodeBlock({ className, children }: any) {
  const [copied, setCopied] = useState(false);
  const lang = /language-([\w-]+)/.exec(className || "")?.[1] || "code";
  const raw = extractCodeText(children).replace(/\n$/, "");

  if (lang === "scriptbox") {
    const parts = raw.split("\n---\n");
    let title = "script";
    let detectedLang = "text";
    let stats = "";
    let fullCode = raw;

    if (parts.length >= 2) {
      const header = parts[0].split("\n");
      for (const h of header) {
        if (h.startsWith("title: ")) title = h.slice(7).trim();
        else if (h.startsWith("lang: ")) detectedLang = h.slice(6).trim();
        else if (h.startsWith("+") && h.includes("-")) stats = h.trim();
      }
      // Legacy messages may still contain another --- + diff tail.
      // Ignore that tail: only the final script is rendered here.
      fullCode = parts[1] || "";
    }

    return (
      <ScriptBox
        title={title}
        lang={detectedLang}
        stats={stats}
        fullCode={fullCode}
      />
    );
  }

  const copy = async () => {
    try {
      await navigator.clipboard.writeText(raw);
      setCopied(true);
      setTimeout(() => setCopied(false), 1600);
    } catch {}
  };

  return (
    <article className="sb sb-prism" data-lines="on">
      <header className="sb-head">
        <h3 className="sb-title">{lang}</h3>
        <span className="sb-chip">{lang.toUpperCase()}</span>
        <button type="button" className="sb-icon-btn" onClick={copy} aria-label="Copy code">
          {copied ? (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M20 6 9 17l-5-5"/></svg>
          ) : (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M4 16V6a2 2 0 0 1 2-2h10"/></svg>
          )}
          <span>{copied ? "Copied" : "Copy"}</span>
        </button>
      </header>
      <pre className="sb-body">
        <ShikiCodeLines code={raw} language={lang} />
      </pre>
    </article>
  );
}

const components: any = {
  code(props: any) {
    const { className, children } = props;
    const lang = /language-([\w-]+)/.exec(className || "")?.[1] || "";
    const text = String(children).replace(/\n$/, "");
    if (lang === "mermaid") return <MermaidBlock code={text} />;
    if (!className && /^#[0-9a-fA-F]{6}$/.test(text.trim())) return <ColorToken hex={text.trim()} />;
    if (!className && !text.includes("\n"))
      return <code className="rounded bg-white/10 px-1.5 py-0.5 text-[0.86em] text-amber-200">{children}</code>;
    return <CodeBlock className={className}>{children}</CodeBlock>;
  },
  pre: (p: any) => <>{p.children}</>,
  table: (p: any) => <div className="my-2 overflow-x-auto rounded-xl border border-white/10"><table className="w-full border-collapse text-[13px] leading-6">{p.children}</table></div>,
  thead: (p: any) => <thead className="bg-white/[0.06]">{p.children}</thead>,
  th: (p: any) => <th className="border-b border-white/10 px-3 py-1.5 text-left font-semibold text-white">{p.children}</th>,
  td: (p: any) => <td className="border-b border-white/[0.06] px-3 py-1.5 align-top text-zinc-300">{p.children}</td>,
  blockquote: (p: any) => <blockquote className="my-2 rounded-r-xl border-l-4 border-[#F4A261] bg-white/[0.04] px-3 py-2 text-zinc-200">{p.children}</blockquote>,
  hr: () => <hr className="my-4 border-white/10" />,
  h1: (p: any) => <h1 className="mb-2 mt-3 text-xl font-bold text-white">{p.children}</h1>,
  h2: (p: any) => <h2 className="mb-1 mt-3 text-lg font-bold text-white">{p.children}</h2>,
  h3: (p: any) => <h3 className="mb-1 mt-2 text-base font-semibold text-white">{p.children}</h3>,
  a: (p: any) => <a className="font-medium text-[#8ab4f8] underline decoration-[#8ab4f8]/40 underline-offset-2" href={p.href} target="_blank" rel="noreferrer">{p.children}</a>,
  ul: (p: any) => <ul className="my-1.5 space-y-1 text-[14px] leading-7">{p.children}</ul>,
  ol: (p: any) => <ol className="my-1.5 list-decimal space-y-1 pl-5 text-[14px] leading-7">{p.children}</ol>,
  li: (p: any) => <li className="text-[14px] leading-7 text-zinc-100">{p.children}</li>,
  input: (p: any) => <input type="checkbox" checked={!!p.checked} disabled className="mt-1 h-3.5 w-3.5 accent-[#34A853]" />,
};

export function Markdown({ text, scriptDiff }: { text: string; scriptDiff?: ScriptDiff }) {
  return (
    <div className="break-words">
      <ScriptDiffContext.Provider value={scriptDiff}>
        <ReactMarkdown remarkPlugins={[remarkGfm, remarkMath]} rehypePlugins={[rehypeKatex]} components={components}>
          {text}
        </ReactMarkdown>
      </ScriptDiffContext.Provider>
    </div>
  );
}
