const XTROUTER_MODEL =
  process.env.XTROUTER_MODEL || "qwen/qwen3.8-max:free";

const GROQ_BASE_URL =
  process.env.GROQ_BASE_URL || "https://api.groq.com/openai/v1";

export type ApiStage = 0 | 1 | 2 | 3;

const AGENT_KEY_ENV: Record<string, {
  xkiro1: string;
  xkiro2: string;
  groq1: string;
  groq2: string;
}> = {
  pm: {
    xkiro1: "XTROUTER_API_KEY_OPTIMUS_1",
    xkiro2: "XTROUTER_API_KEY_OPTIMUS_2",
    groq1: "GROQ_API_KEY_OPTIMUS_1",
    groq2: "GROQ_API_KEY_OPTIMUS_2",
  },
  designer: {
    xkiro1: "XTROUTER_API_KEY_ULTRON_1",
    xkiro2: "XTROUTER_API_KEY_ULTRON_2",
    groq1: "GROQ_API_KEY_ULTRON_1",
    groq2: "GROQ_API_KEY_ULTRON_2",
  },
  frontend: {
    xkiro1: "XTROUTER_API_KEY_VEXTRON_1",
    xkiro2: "XTROUTER_API_KEY_VEXTRON_2",
    groq1: "GROQ_API_KEY_VEXTRON_1",
    groq2: "GROQ_API_KEY_VEXTRON_2",
  },
  backend: {
    xkiro1: "XTROUTER_API_KEY_MEGATRON_1",
    xkiro2: "XTROUTER_API_KEY_MEGATRON_2",
    groq1: "GROQ_API_KEY_MEGATRON_1",
    groq2: "GROQ_API_KEY_MEGATRON_2",
  },
  qa: {
    xkiro1: "XTROUTER_API_KEY_CYBERTRON_1",
    xkiro2: "XTROUTER_API_KEY_CYBERTRON_2",
    groq1: "GROQ_API_KEY_CYBERTRON_1",
    groq2: "GROQ_API_KEY_CYBERTRON_2",
  },
};

const value = (name: string): string | undefined => {
  const v = process.env[name];
  return v && v.trim() ? v.trim() : undefined;
};

export const AGENT_MODELS: Record<string, string[]> = {
  pm: [XTROUTER_MODEL],
  designer: [XTROUTER_MODEL],
  frontend: [XTROUTER_MODEL],
  backend: [XTROUTER_MODEL],
  qa: [XTROUTER_MODEL],
};

export function apiKeyFor(
  agentId: string,
  stage: ApiStage,
): string | undefined {
  const keys = AGENT_KEY_ENV[agentId];
  if (!keys) return undefined;

  const envName =
    stage === 0 ? keys.xkiro1 :
    stage === 1 ? keys.xkiro2 :
    stage === 2 ? keys.groq1 :
    keys.groq2;

  return value(envName);
}

export function apiModelsFor(
  _agentId: string,
  stage: ApiStage,
): string[] {
  if (stage === 2 || stage === 3) {
    return ["groq/compound", "groq/compound"];
  }

  return [XTROUTER_MODEL];
}

export function apiBaseUrlFor(
  _agentId: string,
  stage: ApiStage,
): string {
  if (stage === 2 || stage === 3) {
    return GROQ_BASE_URL;
  }

  return process.env.XTROUTER_BASE_URL || "https://api.xkiro.com/v1";
}

/*
 * Backward compatibility for existing title/agenda code.
 */
export function groqKeyFor(agentId: string): string | undefined {
  return apiKeyFor(agentId, 0);
}

export function groqApiKeyA(): string | undefined {
  return apiKeyFor("pm", 0);
}

export function groqApiKeyB(): string | undefined {
  return apiKeyFor("designer", 0);
}

export function groqApiKey(): string | undefined {
  return groqApiKeyA();
}

export function groqApiKeyFor(
  slot: "A" | "B",
): string | undefined {
  return slot === "B" ? groqApiKeyB() : groqApiKeyA();
}
