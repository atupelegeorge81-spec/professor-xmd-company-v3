import { Client, Databases, Query } from "node-appwrite";

export interface LedgerObjection {
  agent: string;
  concern: string;
  severity: string;
  resolution: "open" | "accepted" | "rejected";
}

export interface LedgerEntry {
  id?: string;
  session_id?: string;
  project_id: string;
  agenda_index: number;
  agenda_item: string;
  status: "LOCKED" | "SUPERSEDED" | "OBJECTED_OPEN" | "FAILED_REVIEW";
  decision_summary: string;
  decision_detail?: string;
  approved_code?: string;
  carried_constraints?: string;
  rationale?: string;
  trade_off?: string;
  evidence?: string;
  sources?: string;
  owners?: string;
  objections?: string;
  supersedes?: string;
  locked_at?: string;
  created_at?: string;
}

const client = new Client();
if (process.env.APPWRITE_ENDPOINT && process.env.APPWRITE_PROJECT_ID && process.env.APPWRITE_API_KEY) {
  client
    .setEndpoint(process.env.APPWRITE_ENDPOINT)
    .setProject(process.env.APPWRITE_PROJECT_ID)
    .setKey(process.env.APPWRITE_API_KEY);
}
const databases = new Databases(client);
const DB = process.env.APPWRITE_DATABASE_ID || "";
const COL = "board_ledger";

export async function saveLedgerEntry(e: LedgerEntry, maxRetries = 3): Promise<string | null> {
  const safeProjectId = typeof e.project_id === 'string' 
    ? e.project_id.slice(0, 100).trim() 
    : String(e.project_id || '').slice(0, 100).trim();
  const safeSessionId = typeof e.session_id === 'string'
    ? e.session_id.slice(0, 100).trim()
    : String(e.session_id || safeProjectId).slice(0, 100).trim();

  if (!safeProjectId) {
    console.error("❌ [Ledger] Haikuweza kuhifadhi: project_id haipo au ni tupu.");
    return null;
  }

  // Hakikisha attributes zote 18 zinakwenda kwa usahihi Appwrite
  const payload: Record<string, any> = {
    session_id: safeSessionId,
    project_id: safeProjectId,
    agenda_index: Number(e.agenda_index) || 0,
    agenda_item: String(e.agenda_item || '').slice(0, 255),
    status: e.status || "LOCKED",
    decision_summary: String(e.decision_summary || '').slice(0, 1000),
    decision_detail: e.decision_detail ? String(e.decision_detail).slice(0, 30000) : "",
    approved_code: e.approved_code ? String(e.approved_code).slice(0, 65000) : "",
    carried_constraints: e.carried_constraints ? String(e.carried_constraints).slice(0, 10000) : "",
    rationale: e.rationale ? String(e.rationale).slice(0, 5000) : "",
    trade_off: e.trade_off ? String(e.trade_off).slice(0, 3000) : "",
    evidence: e.evidence ? String(e.evidence).slice(0, 3000) : "",
    sources: e.sources ? String(e.sources).slice(0, 2000) : "",
    owners: e.owners ? String(e.owners).slice(0, 255) : "",
    objections: e.objections ? String(e.objections).slice(0, 5000) : "",
    supersedes: e.supersedes ? String(e.supersedes).slice(0, 64) : "",
    locked_at: e.locked_at || new Date().toISOString(),
    created_at: e.created_at || new Date().toISOString(),
  };

  for (let attempt = 1; attempt <= maxRetries; attempt++) {
    try {
      const doc = await databases.createDocument(DB, COL, "unique()", payload);
      console.log(`✅ [Ledger] Agenda #${e.agenda_index} (${e.status}) imehifadhiwa. ID: ${doc.$id}`);
      return doc.$id;
    } catch (err: any) {
      console.warn(`⚠️ [Ledger] Jaribio la ${attempt}/${maxRetries} limeshindwa kuhifadhi Agenda #${e.agenda_index}:`, err?.message || err);
      if (attempt < maxRetries) {
        await new Promise((r) => setTimeout(r, attempt * 1000));
      } else {
        console.error(`❌ [Ledger] FATAL: Majaribio yote ${maxRetries} yameshindwa kuhifadhi Agenda #${e.agenda_index}:`, err);
        return null;
      }
    }
  }
  return null;
}

export async function listLedger(projectId: string): Promise<LedgerEntry[]> {
  try {
    const res = await databases.listDocuments(DB, COL, [
      Query.equal("project_id", projectId),
      Query.limit(100),
    ]);
    return res.documents.map((d: any) => ({ ...d, id: d.$id })) as LedgerEntry[];
  } catch {
    return [];
  }
}

// Final Board Resolution = Ledger iliyochujwa (LOCKED tu, imepangwa kwa agenda_index)
export async function finalBoardResolution(projectId: string): Promise<LedgerEntry[]> {
  const all = await listLedger(projectId);

  // Current canonical state per agenda item.
  // LOCKED and OBJECTED_OPEN are both valid current states.
  // SUPERSEDED entries stay in history but are excluded here.
  const canonical = new Map<number, LedgerEntry>();

  for (const entry of all) {
    if (
      entry.status !== "LOCKED" &&
      entry.status !== "OBJECTED_OPEN"
    ) {
      continue;
    }

    const previous = canonical.get(entry.agenda_index);

    const currentTime = new Date(
      entry.created_at || entry.locked_at || 0
    ).getTime();

    const previousTime = previous
      ? new Date(
          previous.created_at || previous.locked_at || 0
        ).getTime()
      : -1;

    if (!previous || currentTime >= previousTime) {
      canonical.set(entry.agenda_index, entry);
    }
  }

  return Array.from(canonical.values()).sort(
    (a, b) => a.agenda_index - b.agenda_index
  );
}

export async function markSuperseded(oldId: string, maxRetries = 3): Promise<boolean> {
  if (!oldId || oldId.trim() === '') return false;
  for (let attempt = 1; attempt <= maxRetries; attempt++) {
    try {
      await databases.updateDocument(DB, COL, oldId, { status: "SUPERSEDED" });
      console.log(`🔄 [Ledger] Imeweka entry ya zamani ${oldId} kama SUPERSEDED`);
      return true;
    } catch (err: any) {
      console.warn(`⚠️ [Ledger] markSuperseded jaribio la ${attempt}/${maxRetries} limeshindwa kwa ${oldId}:`, err?.message || err);
      if (attempt < maxRetries) {
        await new Promise((r) => setTimeout(r, attempt * 1000));
      }
    }
  }
  console.error(`❌ [Ledger] Imeshindwa kubadili ${oldId} kuwa SUPERSEDED baada ya majaribio ${maxRetries}`);
  return false;
}

export async function getCarriedConstraints(projectId: string, sessionId?: string): Promise<string> {
  try {
    const all = await listLedger(projectId);
    const canonical = new Map<number, LedgerEntry>();
    for (const entry of all) {
      if (sessionId && entry.session_id && entry.session_id !== sessionId) continue;
      if (entry.status !== "LOCKED") continue;
      const prev = canonical.get(entry.agenda_index);
      const currentTime = new Date(entry.created_at || entry.locked_at || 0).getTime();
      const prevTime = prev ? new Date(prev.created_at || prev.locked_at || 0).getTime() : -1;
      if (!prev || currentTime >= prevTime) {
        canonical.set(entry.agenda_index, entry);
      }
    }

    const sorted = Array.from(canonical.values()).sort((a, b) => a.agenda_index - b.agenda_index);
    const constraintsList: string[] = [];

    for (const item of sorted) {
      if (item.carried_constraints && item.carried_constraints.trim().length > 0) {
        constraintsList.push(`[Agenda ${item.agenda_index}: ${item.agenda_item}]: ${item.carried_constraints.trim()}`);
      } else if (item.decision_summary) {
        constraintsList.push(`[Agenda ${item.agenda_index}: ${item.agenda_item}]: ${item.decision_summary.trim()}`);
      }
    }

    return constraintsList.join("\n");
  } catch (err) {
    console.warn("⚠️ [Ledger] Failed to fetch carried constraints:", err);
    return "";
  }
}
