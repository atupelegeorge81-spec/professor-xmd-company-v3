anchor = "  onTurnComplete?: (id: string) => void;\n}) {"
if anchor not in b:
    raise SystemExit("STOP: BoardMessage parameter anchor not found")
b = b.replace(
    anchor,
    "  onTurnComplete?: (id: string) => void;\n  dissolve?: { oldCode: string; newCode: string };\n}) {",
