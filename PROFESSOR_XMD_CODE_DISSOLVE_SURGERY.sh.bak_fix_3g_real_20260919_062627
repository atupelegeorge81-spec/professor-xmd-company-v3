            runner.items.splice(oldIndex, 1);

            // Persist only the replacement marker; never the old dissolved script.
            const replacement =
              replacementByPointer && replacementByPointer.kind === "msg"
                ? replacementByPointer
                : [...runner.items]
                    .reverse()
                    .find(
                      (x) =>
                        x.kind === "msg" &&
                        x.agentId === oldItem.agentId &&
                        typeof x.content === "string" &&
                        /```[\\s\\S]*```/.test(x.content),
                    );
            if (replacement && replacement.kind === "msg") {
              replacement.corrected = true;
              bcast({ type: "msg_corrected", id: replacement.id });
            }

