# 3f. Put dissolve block in the existing answer location and add corrected marker.
old_answer = '''          {showAnswer && (
            <div className="break-words text-[14px] leading-6 text-foreground">
              <Markdown
                text={
                  mountedDoneRef.current || (item.done && answerCaughtUp)
                    ? item.content || ""
                    : displayedContent || ""
                }
              />
            </div>
          )}
'''
if old_answer not in b:
    raise SystemExit('STOP: BoardMessage answer block not found')
new_answer = '''          {dissolve ? (
            <div className="break-words text-[14px] leading-6 text-foreground">
              <CodeDissolveBlock oldCode={dissolve.oldCode} newCode={dissolve.newCode} />
            </div>
          ) : showAnswer ? (
            <div className="break-words text-[14px] leading-6 text-foreground">
              <div className="my-2 overflow-hidden rounded-xl">
                {item.corrected && item.done && /```[\\s\\S]*```/.test(item.content || "") && (
                  <div className="mb-1.5 flex items-center gap-2 text-[9px] font-semibold uppercase tracking-[0.14em] text-emerald-300/90">
                    <span className="grid h-4 w-4 place-items-center rounded-full border border-emerald-400/25 bg-emerald-400/10">✓</span>
                    Script corrected
                  </div>
                )}
                <Markdown
                  text={
                    mountedDoneRef.current || (item.done && answerCaughtUp)
                      ? item.content || ""
                      : displayedContent || ""
                  }
                />
              </div>
              {!mountedDoneRef.current &&
                displayedContent.length < (item.content?.length ?? 0) && (
                <span className="caret" />
              )}
            </div>
          ) : null}
'''
b = b.replace(old_answer, new_answer, 1)

# 3g. Pass dissolve state from the item map.
old_map = '            return <BoardMessage key={it.id} item={it} />;'
new_map = '            return <BoardMessage key={it.id} item={it} dissolve={codeDissolves[it.id]} />;'
if old_map not in b:
    raise SystemExit('STOP: BoardRoom BoardMessage map line not found')
b = b.replace(old_map, new_map, 1)

# 3h. Persist corrected flag when adding a message? load handles it; new default is absent.
# Keep normal msg_reset untouched. That is important for retries/stream resets.

BOARD.write_text(b)
print('✅ BoardRoom.tsx patched')
PY
then
  echo "❌ Surgery stopped. Restoring all files from backup..."
  cp "$BACKUP_DIR/src/lib/types.ts" src/lib/types.ts
  cp "$BACKUP_DIR/src/lib/boardRunner.ts" src/lib/boardRunner.ts
  cp "$BACKUP_DIR/src/lib/reports.ts" src/lib/reports.ts
  cp "$BACKUP_DIR/src/components/BoardRoom.tsx" src/components/BoardRoom.tsx
