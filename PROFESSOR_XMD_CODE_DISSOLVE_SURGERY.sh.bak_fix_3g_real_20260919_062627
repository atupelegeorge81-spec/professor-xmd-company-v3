  src/lib/types.ts src/lib/boardRunner.ts src/components/BoardRoom.tsx

echo

echo "--- NORMAL msg_reset remains normal ---"
grep -n -A 5 -B 2 'case "msg_reset"' src/components/BoardRoom.tsx | head -20

echo

