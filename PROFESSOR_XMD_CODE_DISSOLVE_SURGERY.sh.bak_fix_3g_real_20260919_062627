# ------------------------------------------------------------
b = BOARD.read_text()

# 3a. Add state after the main useState section, anchored to handleEvent.
if 'const [codeDissolves' not in b:
    anchor = '  const handleEvent = useCallback('
    if anchor not in b:
        raise SystemExit('STOP: BoardRoom patchMsg anchor not found')
    state_insert = '''  const [codeDissolves, setCodeDissolves] = useState<
    Record<string, { oldCode: string; newCode: string }>
  >({});

'''
    b = b.replace(anchor, state_insert + anchor, 1)

# 3b. Extend handleEvent with new event cases.
if 'case "code_dissolve_start":' not in b:
    anchor = '''        case "msg_reset":
          setItems((l) =>
            l.map((it) => (it.kind === "msg" && it.id === e.id ? { ...it, content: "" } : it)),
          );
          break;
'''
    if anchor not in b:
        raise SystemExit('STOP: BoardRoom msg_reset case not found')
    replacement = anchor + '''        case "code_dissolve_start":
          setCodeDissolves((current) => ({
            ...current,
            [e.id]: { oldCode: e.oldCode, newCode: e.newCode },
          }));
          break;
        case "msg_corrected":
          patchMsg(e.id, { corrected: true });
