    # Do not guess where dissolveMessage belongs.
    if 'type: "code_dissolve_start"' in r and 'msg_remove' in r:
        print('ℹ️ boardRunner.ts already contains the surgery markers.')
    else:
        raise SystemExit('STOP: exact dissolveMessage block not found in boardRunner.ts')

# ------------------------------------------------------------
# 3) REPORTS — persist corrected marker on session item only
# ------------------------------------------------------------
rep = ROOT / "src/lib/reports.ts"
rr = rep.read_text()
if "  corrected?: boolean;" not in rr:
