            const isCodeMessage = /```[\\s\\S]*```/.test(oldCode);

            // Preserve the legacy dissolve behavior for ordinary non-code messages.
            if (!isCodeMessage) {
              bcast({ type: "msg_reset", id: msgId });
              bcast({ type: "token", id: msgId, text: markerText });
              setItemContent(msgId, markerText);
              bcast({ type: "msg_done", id: msgId });
              return;
            }

            const replacementFromPointer = lastVisibleMsgId[oldItem.agentId || ""];
            const replacementByPointer =
              replacementFromPointer && replacementFromPointer !== msgId
                ? runner.items.find((x) => x.kind === "msg" && x.id === replacementFromPointer)
                : undefined;

            const sameAgentCode = runner.items
              .filter(
                (x) =>
                  x.kind === "msg" &&
                  x.id !== msgId &&
                  x.agentId === oldItem.agentId &&
                  typeof x.content === "string" &&
                  /```[\\s\\S]*```/.test(x.content),
              )
              .map((x) => (x.kind === "msg" ? x.content || "" : ""))
              .filter(Boolean);
            const newCode =
              (replacementByPointer && replacementByPointer.kind === "msg"
                ? replacementByPointer.content || ""
                : sameAgentCode[sameAgentCode.length - 1]) || "";

            // Remove the obsolete script BEFORE persistence. The client keeps a
